# Copy this file to .env and fill in the values locally.
# The API, worker and frontend share this root file; Next exposes only the two public browser values below.

# Server/worker only. Keep these out of browser code and VITE_ variables.
# If OPENAI_API_KEY is already set in your environment, remove the blank line below.
OPENAI_API_KEY=
OPENAI_MODEL=
# Explicit USD rates per million tokens, keyed by the exact requested model.
# Empty pricing disables paid dispatch. Fill only after verifying current rates.
# OPENAI_PRICES={"MODEL_ID":{"input_per_million":"RATE","cached_input_per_million":"RATE","output_per_million":"RATE"}}
OPENAI_PRICES={}
# Optional, separately budgeted Decisions classification. No model is selected automatically.
OPENAI_DECISIONS_MODEL=
# Decisions pricing additionally requires cache_write_per_million and output_per_million=0.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=

# Browser configuration. Only the publishable key belongs here.
# Use the same project URL as SUPABASE_URL above.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server/worker database connection, required for migrations and background jobs.
# Supabase Dashboard -> Connect -> Session pooler (port 5432).
# Copy the exact pooler host from that dialog; replace every YOUR_ placeholder.
# Use your database password, separate from the API keys above.
# URL-encode special characters in the password (for example, @ becomes %40).
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_URL_ENCODED_DB_PASSWORD@YOUR_SESSION_POOLER_HOST:5432/postgres?sslmode=require


# Optional server-only GeBIZ notice jobs. Empty by default; this grants no paid budget.
# Each entry: key, workspace_id, intake_owner_user_id, source_url, enabled.
# For one daily scan per workspace, use source_url:
# https://www.gebiz.gov.sg/ptn/opportunity/BOListing.xhtml?origin=opportunities
# Existing jobs can still point at a supported individual public tender notice.
NOTICE_SOURCE_JOBS=[]
